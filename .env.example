# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience ID
# Create an audience at https://resend.com/audiences
# Then copy the audience ID from the audience settings
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Email Notifications
# If set, you'll receive an email notification for each new signup
# NOTIFICATION_EMAIL must be set along with FROM_EMAIL to enable notifications
NOTIFICATION_EMAIL=your-email@example.com
FROM_EMAIL=noreply@yourdomain.com

# Supabase (Cloud Foundation — optional account / saved designs on /art)
# These two values are PUBLIC by design: the anon key is safe in the client
# bundle because Row Level Security is the actual security boundary.
# Vite inlines ONLY these two keys into the build (see vite.config.js `define`).
# Locally, copy the URL + anon key printed by `npm run db:start` (supabase start).
# In production, set them in Vercel + GitHub Actions build env.
# NEVER put SUPABASE_SERVICE_ROLE_KEY here or anywhere the client build can read it.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-or-project-anon-key
