# Resend API Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend Audience ID
# Create an audience at https://resend.com/audiences
# Then copy the audience ID from the audience settings
RESEND_AUDIENCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional: Email Notifications
# If set, you'll receive an email notification for each new signup
# NOTIFICATION_EMAIL must be set along with FROM_EMAIL to enable notifications
NOTIFICATION_EMAIL=your-email@example.com
FROM_EMAIL=noreply@yourdomain.com
